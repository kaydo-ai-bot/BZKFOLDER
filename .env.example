# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_CDE: Code secret CDE immuable du propriétaire pour accéder à l'espace /admin
OWNER_CDE="MY_SECRET_OWNER_CDE"

# ADMIN_ACCESS: Alias de secours pour le code d'accès propriétaire
ADMIN_ACCESS="MY_SECRET_OWNER_CDE"
